# ローカル開発用の統合テンプレート。
# 実際の値を入れて `.env.local` として保存する（.gitignore 済みなのでコミットされない）。
#
# 注意: Vite（フロントエンド）はリポジトリ直下の .env* を読み、
#       Firebase Functions エミュレータは functions/.env* を読む。
#       読み込み場所が別なので、下の2ブロックはコピー先が異なる:
#         - [Frontend] ブロック → このファイルのまま直下に .env.local として置けばOK
#         - [Functions] ブロック → functions/.env.local としても複製する
#             cp .env.local functions/.env.local   （後で該当行だけ残してもよい）

# ================================
# [Frontend] Vite / Firebase Hosting 経由の設定
# ================================

# バックエンド(Cloud Functions)のベースURL。既定値は "/api"（Hosting の rewrite 経由）。
# 別オリジンに置く場合のみ設定する。
# VITE_API_BASE_URL=/api

# vite dev server が /api をプロキシする先（Functions エミュレータ）
# VITE_API_PROXY_TARGET=http://127.0.0.1:5001

# エミュレータは /<projectId>/<region>/api 配下に生えるので、そのプレフィックスを指定する
# VITE_FUNCTIONS_EMULATOR_PREFIX=/your-project-id/asia-northeast1/api

# ================================
# [Functions] Cloud Functions が使う Google API キー
# ================================
# 実キーは絶対にコミットしない。本番は Secret Manager を使う:
#   firebase functions:secrets:set GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY=your-google-maps-platform-api-key

# ================================
# [Firebase project] firebase CLI が参照するプロジェクトID
# ================================
# .firebaserc.example と同じ値。CLI 自体は .firebaserc（JSON）しか読まないため、
# ここに書いても自動反映はされない。値をメモしておく用途、または
# 別スクリプトから読みたい場合のために残している。
# FIREBASE_PROJECT_ID=your-firebase-project-id
